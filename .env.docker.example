# Copy this file to .env before running `docker compose up`:
#   cp .env.docker.example .env
#
# Every value here is consumed by both docker-compose.yml (container wiring)
# and the Laravel app itself (same .env file is mounted into the containers).

APP_NAME=Inbxer
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public URL the app is reached at — set this to your real domain/IP.
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (MySQL container, service name "mysql") -----------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inbxer
DB_USERNAME=inbxer
DB_PASSWORD=change-me
# Root password used only to initialize the mysql container.
DB_ROOT_PASSWORD=change-me-too

# --- Cache / Sessions / Queue (Redis container, service name "redis") -------
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Realtime (Laravel Reverb, bundled in the app container) ----------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=inbxer
REVERB_APP_KEY=change-me-reverb-key
REVERB_APP_SECRET=change-me-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- File uploads -------------------------------------------------------------
# "public" stores in the container's local disk (fine for a single server —
# make sure the "storage" volume in docker-compose.yml is persisted/backed up).
# Set MEDIA_DISK=s3 and fill in AWS_* below to use S3 or an S3-compatible store.
FILESYSTEM_DISK=public
MEDIA_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail ---------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"

INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_WEBHOOK_SECRET=

# --- Slack integration (optional) ---------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=
SLACK_MANUAL_INGESTION_REACTION=ticket

# --- Container user (match your host UID/GID to avoid permission issues on
#     bind-mounted volumes; run `id -u`/`id -g` on Linux/macOS to find yours) --
PUID=1000
PGID=1000

VITE_APP_NAME="${APP_NAME}"
